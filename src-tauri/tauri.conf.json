{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oil-git",
  "version": "0.1.0",
  "identifier": "org.oiloil.oilgit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "oil-git",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 540,
        "backgroundColor": "#282c34"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "看清项目的分支、提交与文件变化",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "../skills/oil-git/": "skills/oil-git/",
      "../bin/": "bin/"
    }
  }
}
